---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/TagList.astro';
import RelatedPosts from '../components/RelatedPosts.astro';

interface Props {
  post: CollectionEntry<'blog'> | CollectionEntry<'blog-en'>;
  lang?: 'zh-Hant' | 'en';
  alternateUrl?: string;
}

const { post, lang = 'zh-Hant', alternateUrl } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, heroWidth, heroHeight, tags } = post.data;

// Calculate aspect ratio for CLS prevention
const hasHeroDimensions = heroWidth && heroHeight;
const heroAspectRatio = hasHeroDimensions ? `${heroWidth} / ${heroHeight}` : null;

const isEnglish = lang === 'en';
const blogListUrl = isEnglish ? '/en/blog' : '/blog';
const collection = isEnglish ? 'blog-en' : 'blog';
const backText = isEnglish ? 'Back to all posts' : '返回文章列表';

const formattedPubDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdatedDate = updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description} image={heroImage} lang={lang} alternateUrl={alternateUrl}>
  <article class="max-w-4xl mx-auto px-4 py-12">
    <header class="mb-8">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">
        {title}
      </h1>

      <div class="flex flex-wrap items-center gap-4 text-sm text-gray-600 dark:text-gray-400">
        <time datetime={pubDate.toISOString()}>
          Published on {formattedPubDate}
        </time>
        {updatedDate && (
          <span>
            (Updated on <time datetime={updatedDate.toISOString()}>{formattedUpdatedDate}</time>)
          </span>
        )}
      </div>

      {tags.length > 0 && (
        <div class="mt-4">
          <TagList tags={tags} lang={lang} />
        </div>
      )}

      {heroImage && (
        <div
          class="mt-8 w-full max-h-[70vh] flex items-center justify-center"
          style={heroAspectRatio ? `aspect-ratio: ${heroAspectRatio}` : undefined}
        >
          <img
            src={heroImage}
            alt={title}
            loading="lazy"
            decoding="async"
            width={heroWidth}
            height={heroHeight}
            class="w-full h-auto max-h-[70vh] rounded-lg object-contain"
          />
        </div>
      )}
    </header>

    <div class="prose dark:prose-invert max-w-none">
      <slot />
    </div>

    <RelatedPosts currentPost={post} collection={collection} />

    <footer class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-800">
      <a
        href={blogListUrl}
        class="inline-flex items-center gap-2 text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        {backText}
      </a>
    </footer>
  </article>
</BaseLayout>
