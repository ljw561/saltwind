---
interface Props {
  title: string;
  description: string;
  image?: string;
  lang?: 'zh-Hant' | 'en';
  alternateUrl?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = '/images/og-default.png', lang = 'zh-Hant', alternateUrl } = Astro.props;

// Compute alternate language URL
const currentPath = Astro.url.pathname;
const isEnglish = lang === 'en';
const computedAlternateUrl = alternateUrl
  ? new URL(alternateUrl, Astro.site).href
  : isEnglish
    ? new URL(currentPath.replace(/^\/en/, '') || '/', Astro.site).href
    : new URL('/en' + (currentPath === '/' ? '/' : currentPath), Astro.site).href;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<link rel="icon" href="/favicon.ico?v=2" sizes="16x16 32x32" type="image/x-icon" />
<link rel="icon" href="/favicon.png?v=2" sizes="32x32" type="image/png" />
<link rel="apple-touch-icon" href="/favicon.png?v=2" />
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Hreflang alternate -->
<link rel="alternate" hreflang={isEnglish ? 'en' : 'zh-Hant'} href={canonicalURL} />
<link rel="alternate" hreflang={isEnglish ? 'zh-Hant' : 'en'} href={computedAlternateUrl} />
<link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<!-- RSS -->
<link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/rss.xml" />

<!-- Dark mode detection -->
<script is:inline>
  (function() {
    const isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    if (isDark) {
      document.documentElement.classList.add('dark');
    }
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
      document.documentElement.classList.toggle('dark', e.matches);
    });
  })();
</script>
