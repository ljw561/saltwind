---
interface Props {
  tags: string[];
  lang?: 'zh-Hant' | 'en';
}

const { tags, lang = 'zh-Hant' } = Astro.props;

// Tag mapping: Chinese display name -> URL slug
const tagToSlug: Record<string, string> = {
  '生活': 'life',
  '製作': 'making',
  '物件': 'obj',
  '發酵': 'fermentation',
  '熟成': 'aging',
  '熟肉': 'charcuterie',
  '麵包': 'bread',
  '咖啡': 'coffee',
  '魚': 'fish',
  '豬肉': 'pork',
  '香腸': 'sausage',
  '食譜': 'recipe',
  '器具': 'equipment',
  '台灣': 'taiwan',
};

const getTagSlug = (tag: string): string => tagToSlug[tag] || tag;
const basePath = lang === 'en' ? '/en/tags' : '/tags';
---

<ul class="flex flex-wrap gap-2">
  {tags.map((tag) => (
    <li>
      <a
        href={`${basePath}/${getTagSlug(tag)}`}
        class="inline-block px-2 py-1 text-xs font-medium rounded-full bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-primary-100 dark:hover:bg-primary-900/30 hover:text-primary-700 dark:hover:text-primary-300 transition-colors"
      >
        #{tag}
      </a>
    </li>
  ))}
</ul>
