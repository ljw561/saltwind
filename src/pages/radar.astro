---
import BaseLayout from '../layouts/BaseLayout.astro';
import RadarSimulation from '../components/RadarSimulation.astro';
---

<BaseLayout
  title="Radar Simulation - Saltwind"
  description="Browser-based radar display simulation."
>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <header class="mb-8 text-center">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-2">
        Radar Simulation
      </h1>
      <p class="text-gray-600 dark:text-gray-400">
        Browser-based radar display simulation.
      </p>
    </header>

    <RadarSimulation />
  </div>
</BaseLayout>
